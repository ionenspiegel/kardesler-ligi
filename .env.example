# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env GitHub'a gönderilmez.
PORT=3000
NODE_ENV=development
DB_PATH=data/lig.db

# En az 32 karakterlik rastgele bir değer. Örnek üretme: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# İlk kurulumda hesapların şifresi (en az 8 karakter). Yalnızca hesap henüz yokken kullanılır.
INITIAL_PASSWORD_YUSUF=
INITIAL_PASSWORD_YUNUS=
INITIAL_PASSWORD_YALCIN=

# Render/Railway gibi bir proxy arkasında yayınlarsan 1 yap.
TRUST_PROXY=
